-- ===========================================================
-- tests/seki/test_analysis_ivt.seki — lib/analysis/ivt.seki の検証
-- ===========================================================

import "../../lib/analysis/ivt.seki"

-- ----- 具体例: f(x) = x² - 2 の二分法収束 (10ステップ後、√2 に十分近い) -----
theorem bisect_converges_sqrt2
  : absR ((midOf bisect10) - (sqrt 2.0)) < 0.01 := by eval

-- ----- 一般定理: 1 ステップの二分法は区間幅を厳密に半分にする -----
-- f がどんな関数であっても (f(a), f(mid) の値自体は unfold の過程で
-- 不透明アトムとして扱われるだけで、この等式の成立に使われていない)
-- 成り立つ、アルゴリズムの構造だけから従う事実。∀a,b∈Real で健全に証明。
theorem bisect_width_halves
  : forall a in Real, forall b in Real,
      (snd (bisect f_sqrt2 a b 1)) - (fst (bisect f_sqrt2 a b 1)) == (b - a) / 2.0
  := by unfold bisect then unfold bisect then algebra

-- 複数ステップでも区間幅が縮み続けることを具体例で確認
theorem width_shrinks_0_to_5  : widthAfter 5 < widthAfter 0 := by eval
theorem width_shrinks_5_to_10 : widthAfter 10 < widthAfter 5 := by eval
