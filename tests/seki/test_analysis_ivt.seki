-- ===========================================================
-- tests/seki/test_analysis_ivt.seki — lib/analysis/ivt.seki の検証
-- ===========================================================

import "../../lib/analysis/ivt.seki"

-- ----- 具体例: f(x) = x² - 2 の二分法収束 (10ステップ後、√2 に十分近い) -----
theorem bisect_converges_sqrt2
  : absR ((midOf bisect10) - (sqrt 2.0)) < 0.01 := by eval

-- ----- 一般定理: 1 ステップの二分法は区間幅を厳密に半分にする -----
-- f がどんな関数であっても (f(a), f(mid) の値自体は unfold の過程で
-- 不透明アトムとして扱われるだけで、この等式の成立に使われていない)
-- 成り立つ、アルゴリズムの構造だけから従う事実。∀a,b∈Real で健全に証明。
theorem bisect_width_halves
  : forall a in Real, forall b in Real,
      (snd (bisect f_sqrt2 a b 1)) - (fst (bisect f_sqrt2 a b 1)) == (b - a) / 2.0
  := by unfold bisect then unfold bisect then algebra

-- 複数ステップでも区間幅が縮み続けることを具体例で確認
theorem width_shrinks_0_to_5  : widthAfter 5 < widthAfter 0 := by eval
theorem width_shrinks_5_to_10 : widthAfter 10 < widthAfter 5 := by eval

-- ===========================================================
-- ivt_general (公理) を by obtain で使う — Skolem 化の具体例
-- ===========================================================

-- f(x) = x³ - x - 2. f(1) = -2, f(2) = 4 なので f(1)*f(2) <= 0 → [1,2] に根がある
def f_cubic := \x -> x * x * x - x - 2.0

-- ivt_general を f_cubic, a=1.0, b=2.0 に特殊化し、根 w を obtain する。
-- w の定義性質 (f_cubic w == 0.0、つまり w³ - w - 2 = 0、つまり w³ = w + 2)
-- を後続の by algebra がシンボリックな仮定として使えることを示す —
-- 「IVT (公理) から、この根 w について w³ = w + 2 が成り立つ」という、
-- IVT を実際に使った (existential elimination による) 厳密な導出。
theorem cubic_root_relation
  : (f_cubic 1.0) * (f_cubic 2.0) <= 0.0 => (w * w * w) == (w + 2.0)
  := by obtain w from ivt_general with f := f_cubic, a := 1.0, b := 2.0
     then unfold f_cubic then algebra

-- obtain した根が区間 [1,2] に収まっていることも同時に使える
-- (by algebra はゴール自体が単一の関係式であることを要求するので、
-- 連言のゴールは各成分に分けて別々の theorem にする)
theorem cubic_root_lower_bound
  : (f_cubic 1.0) * (f_cubic 2.0) <= 0.0 => 1.0 <= w
  := by obtain w from ivt_general with f := f_cubic, a := 1.0, b := 2.0 then algebra

theorem cubic_root_upper_bound
  : (f_cubic 1.0) * (f_cubic 2.0) <= 0.0 => w <= 2.0
  := by obtain w from ivt_general with f := f_cubic, a := 1.0, b := 2.0 then algebra
