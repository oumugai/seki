-- ===========================================================
-- lib/analysis/ivt.seki — 中間値の定理 (IVT)
--
-- 中間値の定理そのもの (「連続関数 f が f(a)<0<f(b) を満たすなら、
-- ある c∈[a,b] で f(c)=0」) は実数の完備性に依存し、一般の関数について
-- **構成的に**証明することは (2026-08 現在) seki のタクティクの範囲を
-- 超える。理由: `exists` の証明は具体的な witness 式を要求し、`axiom`
-- は真偽タグとしてしか働かず計算内容 (witness 抽出手続き) を持たない
-- ため、「完備性の公理から sup S のような記号的 witness を取り出し、
-- 二分法の極限として根を構成する」という手順を実行する土台が無い。
--
-- そこで本ファイルは二段構えで IVT を扱う:
--   1. IVT の**計算的な核心**である二分法アルゴリズムを実装し、
--      アルゴリズムの不変条件 (区間幅が毎ステップ半分になること) を
--      次数・関数によらず一般に (∀a,b∈Real) 証明する (完全に構成的・健全)。
--   2. IVT そのものは `axiom` として (証明なしに、古典的な事実として)
--      宣言し、`by obtain` (existential elimination、2026-08 追加) で
--      その witness を後続の証明のシンボリックな仮定として使えるように
--      する。axiom 自体は「証明」ではないが、`by obtain` により
--      **その先の定理を IVT から厳密に導出する**ことができる —
--      これは多くの形式化ライブラリが実数の完備性を扱う標準的な方法
--      (公理として認め、そこから構成的に演繹する) でもある。
--
-- 公開する名前:
--   def bisect f a b n           — n ステップの二分法。符号が変わる側の
--                                    半区間を選び続け、狭めた区間 (a',b') を返す
--   theorem bisect_width_halves  — 1 ステップで区間幅が半分になる (一般)
--   axiom ivt_general             — 中間値の定理そのもの (古典的公理)
-- ===========================================================

import "limit.seki"

-- ----- 中間値の定理 (古典的公理として宣言) -----
-- f, a, b は forall で束縛せず自由変数のまま残す (関数を走る forall の
-- 域が seki の Set 概念では自然に表現できないため)。`by obtain w from
-- ivt_general with f := ..., a := ..., b := ... then <closer>` で
-- 具体的な f, a, b に特殊化し、witness w の性質 (a<=w<=b, f(w)=0) を
-- <closer> の仮定として使う。
axiom ivt_general
  : (f a) * (f b) <= 0.0
    => (exists c in Real, (a <= c) and (c <= b) and ((f c) == 0.0))

-- ----- 二分法本体 -----
-- f(a)*f(mid) <= 0 なら根が [a,mid] 側にあると判断してそちらを選ぶ
-- (等号 <= 0 を含めているので mid がちょうど根のときも正しく停止できる)。
def bisect := \f a b n ->
    if n == 0 then (a, b)
    else
        let mid = (a + b) / 2.0 in
        if (f a) * (f mid) <= 0.0 then bisect f a mid (n - 1)
        else bisect f mid b (n - 1)

-- ----- 具体例: f(x) = x² - 2 (根は √2) -----
def f_sqrt2 := \x -> x * x - 2.0
def bisect10 := bisect f_sqrt2 0.0 2.0 10
def midOf := \ab -> ((fst ab) + (snd ab)) / 2.0

-- 複数ステップでの区間幅の推移を追う補助関数
-- (n ステップでの厳密な閉じた式 width(n) = (b-a)/2^n の一般証明は、
-- pow の指数が変数になるため `by algebra`/`by induction` の対応範囲外 —
-- 詳細は docs/spec/06-soundness.md)
def widthAfter := \n ->
    let ab = bisect f_sqrt2 0.0 2.0 n in
    (snd ab) - (fst ab)

-- theorem (証明) は tests/seki/test_analysis_ivt.seki 側に置く
-- (公開する `bisect_width_halves` は「1ステップの二分法は f・a・b に
-- よらず区間幅を厳密に半分にする」という一般定理)。
