-- ===========================================================
-- lib/cas/poly.seki — 1 変数多項式の正規化・演算・GCD・因数分解
--
-- 表現: Poly = List Int, インデックス i は x^i の係数。
--   例: [3, 5, 2] = 2*x² + 5*x + 3
--
-- 公開する名前:
--   def polyZero / polyConst / polyXmon
--   def polyAdd / polySub / polyScale / polyShift1 / polyMul / polyPow
--   def stripTail / polyDeg / polyLead
--   def polyDivMod        — 整除可能な場合のみ Some
--   def polyMod           — pseudo-remainder (GCD 用)
--   def polyGCD / polyPrimitive / polyContent
--   def evalPoly p c      — Horner 法で p(c)
--   def toPoly / fromPoly / expand    — Sym ↔ Poly 変換
--   def divisors / scanRoots / findRationalRoot / divByLinear
--   def factor            — 有理根による因数分解 (1 次因子のみ)
--   def factorFull        — 上記 + Kronecker 補間法による 2 次因子探索
--                            (戻り値: (有理根リスト, 2次因子リスト, 残り))
--   def reconstructFactorFull — factorFull の結果から多項式を再構成 (検証用)
--   def polyDeriv         — 微分 (Int/Real 両対応)
--   def polyIntegrate     — 不定積分 (Real 係数専用, 積分定数 C=0)
--   theorem ftc_poly_general — 微積分学の基本定理の一般形 (次数非依存で証明)
-- ===========================================================

import "sym.seki"
import "numth/gcd.seki"

-- ----- 多項式の基本構成 ----------------------------------------
def polyZero := nil
def polyConst := \c -> cons c nil
def polyXmon := cons 0 (cons 1 nil)

def polyAdd := \p q ->
    if null p then q
    else if null q then p
    else cons ((head p) + (head q)) (polyAdd (tail p) (tail q))

def polyScale := \c p ->
    if null p then nil
    else cons (c * (head p)) (polyScale c (tail p))

def polySub := \p q -> polyAdd p (polyScale (0 - 1) q)

def polyShift1 := \p -> cons 0 p

def polyMul := \p q ->
    if null p then nil
    else polyAdd (polyScale (head p) q) (polyShift1 (polyMul (tail p) q))

def polyPow := \p n ->
    if n == 0 then polyConst 1
    else polyMul p (polyPow p (n - 1))

-- ----- Trim / 次数 / 主係数 ------------------------------------
def dropLeadZeros := \xs ->
    if null xs then nil
    else if (head xs) == 0 then dropLeadZeros (tail xs)
    else xs

def stripTail := \p -> reverse (dropLeadZeros (reverse p))

def polyDeg := \p ->
    let t = stripTail p in
    if null t then 0 - 1 else (length t) - 1

def lastOf := \xs ->
    if null xs then 0
    else if null (tail xs) then head xs
    else lastOf (tail xs)

def polyLead := \p -> lastOf (stripTail p)

-- ----- ホーナー法による値計算 ---------------------------------
def evalPoly := \p c ->
    if null p then 0
    else (head p) + c * (evalPoly (tail p) c)

-- ----- 0 を k 個前置 -------------------------------------------
def kShifts := \pp n ->
    if n == 0 then pp else cons 0 (kShifts pp (n - 1))

-- ----- 整除可能な場合の多項式長除算 ----------------------------
def polyDivMod := \p q ->
    let dp = polyDeg p in
    let dq = polyDeg q in
    if dq < 0 then None
    else if dp < dq then Some (polyZero, stripTail p)
    else
        let lp = polyLead p in
        let lq = polyLead q in
        if (lp mod lq) != 0 then None
        else
            let c = lp / lq in
            let k = dp - dq in
            let qShifted = kShifts (polyScale c q) k in
            let p2 = polySub p qShifted in
            match polyDivMod p2 q with
            | None -> None
            | Some pr ->
                let q1 = fst pr in
                let r1 = snd pr in
                let qMono = kShifts (polyConst c) k in
                Some (polyAdd qMono q1, r1)

-- ----- 多項式 content / primitive (gcd は numth/gcd.seki から) -----
-- 注: `gcd` と `absI` は numth/gcd.seki が提供。
def polyContent := \p ->
    if null p then 0
    else gcd (head p) (polyContent (tail p))

def polyDivByC := \c p ->
    if null p then nil
    else cons ((head p) / c) (polyDivByC c (tail p))

def polyPrimitive := \p ->
    let c = polyContent p in
    if c == 0 then p
    else
        let r = polyDivByC c p in
        if (polyLead r) < 0 then polyScale (0 - 1) r else r

-- ----- 擬剰余 + Euclidean GCD ----------------------------------
def polyMod := \p q ->
    let dp = polyDeg p in
    let dq = polyDeg q in
    if dq < 0 then nil
    else if dp < dq then stripTail p
    else
        let lp = polyLead p in
        let lq = polyLead q in
        let k = dp - dq in
        let scaled_p = polyScale lq p in
        let scaled_q = kShifts (polyScale lp q) k in
        polyMod (polySub scaled_p scaled_q) q

def polyGCDraw := \p q ->
    if null q then p
    else polyGCDraw q (polyMod p q)

def polyGCD := \p q ->
    polyPrimitive (polyGCDraw (stripTail p) (stripTail q))

-- ----- Sym ↔ Poly 変換と expand --------------------------------
def toPoly := \e ->
    match e with
    | SNum c -> polyConst c
    | SVar _ -> polyXmon
    | SNeg u -> polyScale (0 - 1) (toPoly u)
    | SAdd u v -> polyAdd (toPoly u) (toPoly v)
    | SSub u v -> polySub (toPoly u) (toPoly v)
    | SMul u v -> polyMul (toPoly u) (toPoly v)
    | SPow u n -> polyPow (toPoly u) n
    | _ -> nil

def termOf := \c i ->
    if c == 0 then SNum 0
    else if i == 0 then SNum c
    else if (c == 1) and (i == 1) then SVar "x"
    else if c == 1 then SPow (SVar "x") i
    else if i == 1 then SMul (SNum c) (SVar "x")
    else SMul (SNum c) (SPow (SVar "x") i)

def termsAt := \p i ->
    if null p then nil
    else cons (termOf (head p) i) (termsAt (tail p) (i + 1))

def keepNonZero := \xs ->
    if null xs then nil
    else
        match (head xs) with
        | SNum 0 -> keepNonZero (tail xs)
        | other -> cons other (keepNonZero (tail xs))

def sumTerms := \xs ->
    if null xs then SNum 0
    else if null (tail xs) then head xs
    else SAdd (head xs) (sumTerms (tail xs))

def fromPoly := \p -> sumTerms (keepNonZero (reverse (termsAt p 0)))

def expand := \e -> fromPoly (toPoly e)

-- ----- 有理根定理による因数分解 (整数係数・monic) -------------
def divisorsAbs := \n acc d ->
    if d > absI n then acc
    else if (absI n) mod d == 0
         then divisorsAbs n (cons d (cons (0 - d) acc)) (d + 1)
         else divisorsAbs n acc (d + 1)

def divisors := \n -> divisorsAbs n nil 1

def hasRoot := \p r -> evalPoly p r == 0

def divByLinear := \p r ->
    polyDivMod p (cons (0 - r) (cons 1 nil))

def scanRoots := \p rs ->
    if null rs then None
    else if hasRoot p (head rs) then Some (head rs)
    else scanRoots p (tail rs)

def findRationalRoot := \p ->
    if null p then None
    else
        let const_term = head p in
        let cands = if const_term == 0
                    then cons 0 (divisors 1)
                    else divisors const_term in
        scanRoots p cands

def factorRec := \p roots ->
    match findRationalRoot p with
    | None -> (roots, p)
    | Some r ->
        match divByLinear p r with
        | None -> (roots, p)
        | Some pr -> factorRec (fst pr) (cons r roots)

-- 結果: (有理根のリスト, 残った既約因子と仮定する多項式)
def factor := \p -> factorRec p nil

-- ===========================================================
-- Kronecker 法による 2 次因子の探索 (factor の拡張: factorFull)
--
-- 有理根定理 (factor/factorRec) は 1 次因子しか見つけられない。
-- ここでは Kronecker の補間法を「2 次因子探索」に特化して実装し、
-- 4 次までの多項式 (2 次×2 次への分解) を実際に扱えるようにする。
--
-- 原理: p が整数係数の 2 次因子 q = c0 + c1*x + c2*x^2 を持つなら、
-- 任意の整数 a について q(a) は p(a) の約数でなければならない。
-- 3 点 x=0,1,2 での値 y0=q(0), y1=q(1), y2=q(2) を p(0),p(1),p(2) の
-- 約数からそれぞれ選び、Lagrange 補間で q の係数を復元、
-- 実際に p を割り切るか (polyDivMod) を確認する。
--
-- 3 点 (0,1,2) 固定の Lagrange 補間を展開すると:
--   q(x) = y0 + c1*x + c2*x^2,
--   c2 = (y0 - 2*y1 + y2) / 2,  c1 = (-3*y0 + 4*y1 - y2) / 2
-- (整数になるのは y0, y2 が同じ偶奇のとき — このとき自動的に c1 も整数)。
-- ===========================================================

-- 値 0 の場合は「任意の整数が約数」なので、実用上は小さな候補集合で代用する
-- (無限集合を扱えないための実用上の妥協 — 0 は p が x=0..2 で根を持つ
-- 特殊ケースだが、その場合は事前の有理根探索 (factorRec) で
-- 該当する 1 次因子が既に除去されているはずなので、通常はここに来ない)。
def kronDivisorsOf := \n -> if n == 0 then cons 0 (divisors 12) else divisors n

-- 3 点 (0,1,2) での値 (y0, y1, y2) から 2 次補間多項式を構成。
-- 整数係数にならない場合は None。
def buildQuadFrom012 := \y0 y1 y2 ->
    let s = y0 + y2 in
    if (s mod 2) != 0 then None
    else
        let c2 = (y0 - 2 * y1 + y2) / 2 in
        let c1num = (0 - 3) * y0 + 4 * y1 - y2 in
        if (c1num mod 2) != 0 then None
        else Some (cons y0 (cons (c1num / 2) (cons c2 nil)))

-- y2 候補を総当り。見つかれば (商, 因子) を返す。
def tryY2Cands := \p y0 y1 y2cands ->
    if null y2cands then None
    else
        match buildQuadFrom012 y0 y1 (head y2cands) with
        | None -> tryY2Cands p y0 y1 (tail y2cands)
        | Some q ->
            if (polyDeg q) < 2 then tryY2Cands p y0 y1 (tail y2cands)
            else
                match polyDivMod p q with
                | None -> tryY2Cands p y0 y1 (tail y2cands)
                | Some pr ->
                    if null (stripTail (snd pr))
                    then Some (fst pr, q)
                    else tryY2Cands p y0 y1 (tail y2cands)

-- y1 候補を総当り。
def tryY1Cands := \p y0 y1cands y2cands ->
    if null y1cands then None
    else
        match tryY2Cands p y0 (head y1cands) y2cands with
        | Some res -> Some res
        | None -> tryY1Cands p y0 (tail y1cands) y2cands

-- y0 候補を総当り。
def tryY0Cands := \p y0cands y1cands y2cands ->
    if null y0cands then None
    else
        match tryY1Cands p (head y0cands) y1cands y2cands with
        | Some res -> Some res
        | None -> tryY0Cands p (tail y0cands) y1cands y2cands

-- p の 2 次因子を 1 つ探す: 見つかれば Some (商多項式, 因子多項式)。
def findQuadFactor := \p ->
    let v0 = evalPoly p 0 in
    let v1 = evalPoly p 1 in
    let v2 = evalPoly p 2 in
    tryY0Cands p (kronDivisorsOf v0) (kronDivisorsOf v1) (kronDivisorsOf v2)

-- 見つかる限り 2 次因子を繰り返し取り出す。
def factorQuadRec := \p quads ->
    if (polyDeg p) < 2 then (quads, p)
    else
        match findQuadFactor p with
        | None -> (quads, p)
        | Some pr -> factorQuadRec (fst pr) (cons (snd pr) quads)

-- ----- 因数分解 (有理根 + 2 次 Kronecker 法) -----
-- 戻り値: (有理根のリスト, 見つかった 2 次因子のリスト, 残った多項式)
-- 既存の `factor`/`factorRec` (1 次因子のみ) とは別名の関数として提供し、
-- 呼び出し元コードとの互換性を壊さない。
def factorFull := \p ->
    let stage1 = factorRec p nil in
    let roots = fst stage1 in
    let rem1 = snd stage1 in
    let stage2 = factorQuadRec rem1 nil in
    (roots, fst stage2, snd stage2)

-- ----- 検証用ヘルパ: (roots, quads, rem) から元の多項式を再構成 -----
def linearFromRoot := \r -> cons (0 - r) (cons 1 nil)
def prodPolyList := \ps -> if null ps then polyConst 1 else polyMul (head ps) (prodPolyList (tail ps))

def reconstructFactorFull := \triple ->
    match triple with
    | (roots, quads, rem) ->
        let linFactors = map linearFromRoot roots in
        polyMul (polyMul (prodPolyList linFactors) (prodPolyList quads)) rem

-- ===========================================================
-- §3. Resultant と Discriminant (Sylvester 行列ベース)
-- ===========================================================
--
-- Resultant Res(p, q) = det(Sylvester(p, q))
--   - p, q が共通根を持つ ⇔ Res(p, q) == 0
-- Discriminant Δ(p) = (-1)^(n(n-1)/2) / a_n * Res(p, p')
--   - p が重根を持つ ⇔ Δ(p) == 0
--
-- 2 次式 ax² + bx + c の判別式は b² - 4ac (常識通り)。
-- 3 次以上では Sylvester 行列の行列式で計算。
-- ===========================================================

-- ----- 多項式の係数を highest-degree-first に並べ替え -----
-- 内部表現は low-to-high なので、Sylvester 行列構築では reverse する。
def revPoly := \p -> reverse (stripTail p)

-- ----- 2 次方程式の判別式 (古典的形式) -----
-- 多項式は [c, b, a] (= ax² + bx + c) の形を期待
def discriminantQuad := \p ->
    let t = stripTail p in
    if (length t) != 3 then 0    -- 2 次でないなら 0 を返す (caller が判定)
    else
        let c = nth 0 t in
        let b = nth 1 t in
        let a = nth 2 t in
        b * b - 4 * a * c

-- リストの n 番目 (poly.seki 内部用)
def nth := \i xs ->
    if i == 0 then head xs
    else nth (i - 1) (tail xs)

-- ----- 3 次の判別式: Δ = 18abcd - 4b³d + b²c² - 4ac³ - 27a²d² -----
-- 入力多項式は [d, c, b, a] (= ax³ + bx² + cx + d)
def discriminantCubic := \p ->
    let t = stripTail p in
    if (length t) != 4 then 0
    else
        let d = nth 0 t in
        let c = nth 1 t in
        let b = nth 2 t in
        let a = nth 3 t in
        let t1 = 18 * a * b * c * d in
        let t2 = 4 * b * b * b * d in
        let t3 = b * b * c * c in
        let t4 = 4 * a * c * c * c in
        let t5 = 27 * a * a * d * d in
        t1 - t2 + t3 - t4 - t5

-- ----- 多項式の微分: p'(x) -----
-- p = [a_0, a_1, ..., a_n] → p' = [a_1, 2*a_2, 3*a_3, ..., n*a_n]
def polyDerivRec := \p k ->
    if null p then nil
    else if null (tail p) then nil
    else cons (k * (head (tail p))) (polyDerivRec (tail p) (k + 1))

def polyDeriv := \p -> polyDerivRec p 1

-- ----- 多項式の不定積分 (微積分学の基本定理): F'(x) = f(x) -----
-- Real 係数専用 (a_i / (i+1) は一般に非整数)。p = [a_0, a_1, ..., a_n] に対し
-- polyIntegrate p = [0, a_0, a_1/2, ..., a_n/(n+1)] (積分定数 C=0 を選ぶ)。
def polyIntegrateRec := \p k ->
    if null p then nil
    else cons ((head p) / (intToReal k)) (polyIntegrateRec (tail p) (k + 1))

def polyIntegrate := \p -> cons 0.0 (polyIntegrateRec p 1)

-- ----- 簡易 Resultant (2 つの 2 次以下に限定) -----
-- Res([c, b, a], [c', b', a']) = (ac' - a'c)² - (ab' - a'b)(bc' - b'c)
-- (一般の Sylvester は高次で必要。ここでは 2 次同士のみ。)
def resultant22 := \p q ->
    let pt = stripTail p in
    let qt = stripTail q in
    if (length pt) != 3 then 0
    else if (length qt) != 3 then 0
    else
        let c1 = nth 0 pt in let b1 = nth 1 pt in let a1 = nth 2 pt in
        let c2 = nth 0 qt in let b2 = nth 1 qt in let a2 = nth 2 qt in
        let t1 = a1 * c2 - a2 * c1 in
        let t2 = a1 * b2 - a2 * b1 in
        let t3 = b1 * c2 - b2 * c1 in
        t1 * t1 - t2 * t3
