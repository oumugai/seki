-- 例5: 容量計画 — 足りない仮定が名指しで返る
--
-- 「ピーク時に必要なノード数で捌けるか」。
-- 仮定が足りないと seki が何を足せばいいか言う。

-- rps: 秒あたりリクエスト、perNode: 1ノードの処理能力、nodes: 台数
theorem capacity_covers_peak
  : forall rps in Real, forall perNode in Real, forall nodes in Real,
      (rps <= 5000.0) and (perNode >= 800.0) and (nodes >= 8.0)
      => perNode * nodes >= rps
  := by algebra

-- ヘッドルーム 30% を残す
theorem thirty_percent_headroom
  : forall rps in Real, forall perNode in Real, forall nodes in Real,
      (rps <= 5000.0) and (perNode >= 800.0) and (nodes >= 10.0)
      => perNode * nodes >= rps * 1.3
  := by algebra
