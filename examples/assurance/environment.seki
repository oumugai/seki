-- ===========================================================
-- 環境についての仮定
--
-- ここにあるものは**証明されていない**。確度と出所を書き、
-- `--audit` がそれを結論まで運ぶ。
-- ===========================================================

-- センサのドリフト。季節性が未補正なので確度は控えめ。
axiom sensor_drift_bounded
  : driftC <= 0.5
  with confidence 0.8 from "現場ログ6か月 (2026-03〜08), 季節性未補正"

-- 外乱の大きさ。設置環境の想定。
axiom disturbance_bounded
  : (disturbC >= 0.0) and (disturbC <= 2.0)
  with confidence 0.9 from "設置仕様書 §4.2 (空調のある屋内)"

-- 起動時の温度。運用手順で保証される。
axiom startup_range
  : (startupC >= 15.0) and (startupC <= 30.0)
  with confidence 0.95 from "運用手順書 SOP-114 (起動前チェック)"
